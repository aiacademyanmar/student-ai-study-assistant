<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Student AI Study"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".NativeChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".OfflineReaderActivity" android:exported="false" />
        <activity android:name=".GceStudyActivity" android:exported="false" />
        <activity android:name=".OLevelSyllabusActivity" android:exported="false" />
        <activity android:name=".ALevelSyllabusActivity" android:exported="false" />
        <activity android:name=".ALevelExamCoverageActivity" android:exported="false" />
        <activity android:name=".ALevelResultsActivity" android:exported="false" />
        <activity android:name=".OfflineQuizActivity" android:exported="false" />
        <activity android:name=".WrittenPracticeActivity" android:exported="false" />
        <activity android:name=".TopicAnalyticsActivity" android:exported="false" />
        <activity android:name=".SyllabusAuditActivity" android:exported="false" />
        <activity android:name=".PromotionActivity" android:exported="false" />
        <activity android:name=".PromptStudioActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SyllabusCoverageActivity" android:exported="false" />
        <activity android:name=".PriorityStudyActivity" android:exported="false" />
        <activity android:name=".TeacherRentActivity" android:exported="false" />
        <activity android:name=".StartActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PremiumStudyActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CatalogActivity" android:screenOrientation="unspecified" android:exported="false" />
    </application>
</manifest>
